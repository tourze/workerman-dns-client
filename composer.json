{
  "name": "tourze/workerman-dns-client",
  "description": "DNS Query Client in Workerman",
  "type": "library",
  "license": "MIT",
  "require": {
    "ext-filter": "*",
    "react/dns": "^1.13",
    "symfony/cache": "^7.3",
    "workerman/workerman": "^5.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/framework-bundle": "^7.3",
    "tourze/phpunit-base": "1.*"
  },
  "autoload": {
    "psr-4": {
      "Tourze\\Workerman\\DnsClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tourze\\Workerman\\DnsClient\\Tests\\": "tests/"
    }
  }
}